<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Privar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Privar scans nearby Bluetooth advertisements so you can review unfamiliar devices.</string>
	<key>NSCameraUsageDescription</key>
	<string>Privar uses your camera to inspect bright reflections and capture areas you want to review.</string>
	<key>NSMotionUsageDescription</key>
	<string>Privar measures the magnetic field to help you inspect changes near electronic objects.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the inspection photo you choose to your photo library.</string>
	<key>PrivarAppStoreURL</key>
	<string>$(PRIVAR_APP_STORE_URL)</string>
	<key>PrivarPrivacyURL</key>
	<string>$(PRIVAR_PRIVACY_URL)</string>
	<key>PrivarProductID</key>
	<string>$(PRIVAR_PRODUCT_ID)</string>
	<key>PrivarTermsURL</key>
	<string>$(PRIVAR_TERMS_URL)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>iconLogo</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
